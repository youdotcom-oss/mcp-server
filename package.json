{
  "name": "@youdotcom-oss/mcp",
  "version": "3.5.0",
  "description": "You.com MCP STDIO bridge for the hosted You.com MCP server",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "bun": ">= 1.2.21"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youdotcom-oss/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/youdotcom-oss/mcp/issues"
  },
  "homepage": "https://github.com/youdotcom-oss/mcp#readme",
  "author": "You.com (https://you.com)",
  "keywords": [
    "mcp",
    "web search",
    "model context protocol",
    "ai research"
  ],
  "bin": "bin/stdio.js",
  "type": "module",
  "files": [
    "bin/stdio.js",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/stdio-bridge.ts --outfile ./bin/stdio.js --target=node",
    "check": "bun run check:biome && bun run check:types",
    "check:biome": "biome check",
    "check:types": "tsc --noEmit",
    "check:write": "biome check --write",
    "dev": "bun src/stdio-bridge.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepare": "git config core.hooksPath .hooks"
  },
  "mcpName": "io.github.youdotcom-oss/mcp",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "latest",
    "lint-staged": "^17.1.0",
    "typescript": "7.0.2",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "prepare": "git config core.hooksPath .hooks"
}
